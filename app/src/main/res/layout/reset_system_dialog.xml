<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_left_bg"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/et_manager_pwd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="恢复出厂设置"
        android:layout_marginTop="@dimen/hy_lay_dp_100"
        android:textColor="#000"
        android:textSize="@dimen/hy_font_sp_30"
        android:theme="@style/myEditText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:gravity="center"
        android:paddingStart="@dimen/hy_lay_dp_16"
        android:paddingEnd="@dimen/hy_lay_dp_16"
        android:orientation="horizontal">

        <Button
            android:textColor="#fff"
            android:id="@+id/bt_reset_cancel"
            android:layout_width="@dimen/hy_lay_dp_200"
            android:layout_height="@dimen/hy_lay_dp_70"
            android:background="@drawable/button_style_bg"
            android:text="取消"
            android:theme="@style/baseTextTheme"  />

        <Button
            android:textColor="#fff"
            android:id="@+id/bt_reset_sure"
            android:layout_width="@dimen/hy_lay_dp_200"
            android:layout_height="@dimen/hy_lay_dp_70"
            android:layout_marginStart="@dimen/hy_lay_dp_30"
            android:background="@drawable/button_style_bg"
            android:text="确定"
            android:theme="@style/baseTextTheme"  />
    </LinearLayout>

</LinearLayout>