<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/li1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="30dp"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="CO2"
            android:theme="@style/baseTextTheme" />

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="260dp"
            android:layout_marginStart="15dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fanTest_value_small"
                    android:theme="@style/baseTextTheme1" />

                <EditText
                    android:id="@+id/et_small_co2"
                    android:layout_width="@dimen/main_tv_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:background="@drawable/rounded_border_bg"
                    android:theme="@style/baseTextTheme" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fanTest_value_middle"
                    android:theme="@style/baseTextTheme1" />

                <EditText
                    android:id="@+id/et_middle_co2"
                    android:layout_width="@dimen/main_tv_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:background="@drawable/rounded_border_bg"
                    android:theme="@style/baseTextTheme" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fanTest_value_high"
                    android:theme="@style/baseTextTheme1" />

                <EditText
                    android:id="@+id/et_high_co2"
                    android:layout_width="@dimen/main_tv_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:background="@drawable/rounded_border_bg"
                    android:theme="@style/baseTextTheme" />

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/bt_co2_set"
        android:layout_width="@dimen/main_bt_width"
        android:layout_height="@dimen/main_bt_height"
        android:layout_alignParentStart="true"
        android:layout_margin="15dp"
        android:background="@drawable/button_style_bg"
        android:gravity="center"
        android:text="@string/setting_CO2"
        android:theme="@style/baseTextTheme2"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/li1" />

    <LinearLayout
        android:id="@+id/li2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="30dp"
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        android:layout_gravity="center_vertical"
        app:layout_constraintLeft_toRightOf="@+id/li1"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="PM2.5"
            android:theme="@style/baseTextTheme" />

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="260dp"
            android:layout_marginStart="15dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fanTest_value_small"
                    android:theme="@style/baseTextTheme1" />

                <EditText
                    android:id="@+id/et_small_pm"
                    android:layout_width="@dimen/main_tv_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:background="@drawable/rounded_border_bg"
                    android:theme="@style/baseTextTheme" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fanTest_value_middle"
                    android:theme="@style/baseTextTheme1" />

                <EditText
                    android:id="@+id/et_middle_pm"
                    android:layout_width="@dimen/main_tv_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:background="@drawable/rounded_border_bg"
                    android:theme="@style/baseTextTheme" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fanTest_value_high"
                    android:theme="@style/baseTextTheme1" />

                <EditText
                    android:id="@+id/et_high_pm"
                    android:layout_width="@dimen/main_tv_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:gravity="center"
                    android:inputType="number"
                    android:background="@drawable/rounded_border_bg"
                    android:theme="@style/baseTextTheme" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/bt_pm_set"
        android:layout_width="@dimen/main_bt_width"
        android:layout_height="@dimen/main_bt_height"
        android:layout_alignParentEnd="true"
        android:layout_margin="15dp"
        android:background="@drawable/button_style_bg"
        android:gravity="center"
        android:text="@string/setting_pm"
        android:theme="@style/baseTextTheme2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/li2" />

</androidx.constraintlayout.widget.ConstraintLayout>