<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/hy_lay_dp_30"
    android:layout_marginBottom="@dimen/hy_lay_dp_29"
    android:orientation="vertical"
    android:id="@+id/ll_home"
    tools:context=".ui.fragment.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/hy_lay_dp_26"
        android:layout_marginRight="@dimen/hy_lay_dp_37"
        android:background="@drawable/home_tq_bg">

        <ImageView
            android:id="@+id/image_temp"
            android:layout_width="@dimen/hy_lay_dp_209"
            android:layout_height="@dimen/hy_lay_dp_184"
            android:layout_marginLeft="@dimen/hy_lay_dp_20"
            android:layout_marginTop="@dimen/hy_lay_dp_23"
            android:layout_marginBottom="@dimen/hy_lay_dp_13"
            android:src="@drawable/image_cloudy" />

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/hy_lay_dp_25">

            <TextView
                android:textColor="#000000"
                android:id="@+id/tv_weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textSize="@dimen/hy_font_sp_50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="@dimen/hy_font_sp_15"
                android:layout_toRightOf="@+id/tv_weather_temp"
                android:text="℃"
                android:textSize="@dimen/hy_font_sp_20" />

            <TextView
                android:textSize="@dimen/hy_font_sp_20"
                android:id="@+id/tv_conditions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_weather_temp"
                android:layout_marginTop="@dimen/hy_font_sp_8"
                android:text="室外状况" />

            <TextView
                android:id="@+id/tv_pollution"
                android:textColor="@color/baseTextColor"
                android:layout_width="@dimen/hy_lay_dp_67"
                android:layout_height="@dimen/hy_lay_dp_27"
                android:layout_below="@+id/tv_weather_temp"
                android:layout_marginLeft="@dimen/hy_lay_dp_40"
                android:layout_marginTop="@dimen/hy_lay_dp_4"
                android:layout_toRightOf="@+id/tv_conditions"
                android:background="@drawable/home_outdoor_conditions_bg"
                android:gravity="center"
                android:text="-" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/hy_lay_dp_79"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_time"
                android:textColor="#000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-:-"
                android:textSize="96sp" />

            <TextView
                android:id="@+id/tv_date"
                android:layout_marginTop="@dimen/hy_lay_dp_19"
                android:textColor="#000000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="-年-月-日"
                android:textSize="@dimen/hy_font_sp_24" />
        </LinearLayout>

        <ImageView
            android:visibility="invisible"
            android:id="@+id/iv_wifi"
            android:layout_marginLeft="@dimen/hy_lay_dp_10"
            android:layout_marginTop="@dimen/hy_lay_dp_14"
            android:tint="#333333"
            android:layout_width="@dimen/hy_lay_dp_33"
            android:layout_height="@dimen/hy_lay_dp_30"
            android:src="@drawable/wifi_icon" />

        <LinearLayout
            android:layout_gravity="center"
            android:layout_marginLeft="@dimen/hy_lay_dp_71"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:visibility="invisible"
                android:layout_gravity="center"
                android:id="@+id/tv_element_pop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:textColor="#ff0000"
                android:layout_marginBottom="@dimen/hy_lay_dp_11"
                android:text="建议更换滤网"
                android:textSize="@dimen/hy_font_sp_16" />
            <RelativeLayout
                android:id="@+id/ll_element"
                android:layout_width="@dimen/hy_lay_dp_126"
                android:layout_height="@dimen/hy_lay_dp_127"
                android:background="@drawable/image_filter_element">

                <TextView
                    android:textColor="#000000"
                    android:id="@+id/tv_element"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="-"
                    android:textSize="@dimen/hy_font_sp_20" />

                <TextView
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_marginLeft="@dimen/hy_lay_dp_15"
                    android:layout_toRightOf="@+id/tv_element"
                    android:text="%"
                    android:textSize="@dimen/hy_font_sp_20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="@dimen/hy_lay_dp_11"
                    android:text="滤芯剩余"
                    android:textSize="@dimen/hy_font_sp_20" />
            </RelativeLayout>
        </LinearLayout>



    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/hy_lay_dp_62"
        android:layout_marginTop="@dimen/hy_lay_dp_23"
        android:layout_marginRight="@dimen/hy_lay_dp_56">
        <ImageView
            android:id="@+id/iv_tempMode"
            android:visibility="gone"
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/select_refrigeration"
            android:contentDescription="制冷图标" />

        <TextView
            android:textColor="#3D3D3D"
            android:layout_toRightOf="@+id/iv_tempMode"
            android:id="@+id/tv_tempMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hy_lay_dp_15"
            android:visibility="gone"
            android:textSize="@dimen/hy_lay_dp_24"
            android:theme="@style/baseTextTheme" />

        <TextView
            android:textColor="#3D3D3D"
            android:text="强制除霜"
            android:layout_toRightOf="@+id/tv_tempMode"
            android:id="@+id/tv_termMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="80dp"
            android:visibility="gone"
            android:textSize="@dimen/hy_lay_dp_24"
            android:theme="@style/baseTextTheme" />

        <TextView
            android:textSize="@dimen/hy_lay_dp_24"
            android:layout_toRightOf="@+id/tv_termMode"
            android:layout_marginLeft="@dimen/hy_lay_dp_30"
            android:id="@+id/outTerm_error_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/out_device_error"
            android:textColor="@color/colorRed"
            android:visibility="gone" />

        <TextView
            android:layout_marginLeft="@dimen/hy_lay_dp_30"
            android:layout_toRightOf="@+id/outTerm_error_info"
            android:id="@+id/room_error_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/room_notify_error"
            android:textSize="@dimen/hy_lay_dp_24"
            android:textColor="@color/colorRed"
            android:visibility="gone" />

        <TextView
            android:textSize="@dimen/hy_lay_dp_24"
            android:layout_marginLeft="@dimen/hy_lay_dp_30"
            android:layout_toRightOf="@+id/room_error_info"
            android:id="@+id/ntc_error_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ntc_error"
            android:textColor="@color/colorRed"
            android:visibility="gone" />

        <TextView
            android:layout_marginRight="@dimen/hy_lay_dp_30"
            android:layout_toLeftOf="@+id/tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="室内状况"
            android:textSize="@dimen/hy_font_sp_24" />

        <TextView
            android:id="@+id/tv"
            android:layout_width="@dimen/hy_lay_dp_87"
            android:layout_height="@dimen/hy_lay_dp_37"
            android:layout_alignParentRight="true"
            android:background="@drawable/home_indoor_quality_bg"
            android:gravity="center"
            android:text="优"
            android:textColor="@color/baseTextColor"
            android:textSize="@dimen/hy_font_sp_20" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/hy_lay_dp_26"
        android:layout_marginTop="@dimen/hy_lay_dp_13"
        android:layout_marginRight="@dimen/hy_lay_dp_25"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/ll_data"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5">

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/home_tq_bg"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:layout_marginLeft="@dimen/hy_lay_dp_29"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:src="@drawable/icon_temperature"
                            android:layout_width="@dimen/hy_lay_dp_37"
                            android:layout_height="@dimen/hy_lay_dp_37"/>
                        <TextView
                            android:textColor="#3D3D3D"
                            android:layout_marginLeft="@dimen/hy_lay_dp_17"
                            android:text="温度"
                            android:textSize="@dimen/hy_font_sp_24"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_marginTop="@dimen/hy_lay_dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_centerHorizontal="true"
                            android:id="@+id/tv_inRoom_temp"
                            android:textColor="#000000"
                            android:textSize="@dimen/hy_font_sp_60"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"/>
                        <TextView
                            android:layout_centerInParent="true"
                            android:layout_toRightOf="@+id/tv_inRoom_temp"
                            android:textColor="#343A38"
                            android:layout_marginLeft="@dimen/hy_lay_dp_26"
                            android:textSize="@dimen/hy_font_sp_30"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="℃"/>
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginLeft="@dimen/hy_lay_dp_21"
                    android:orientation="vertical"
                    android:background="@drawable/home_tq_bg"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:layout_marginLeft="@dimen/hy_lay_dp_29"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:src="@drawable/icon_humidity"
                            android:layout_width="@dimen/hy_lay_dp_37"
                            android:layout_height="@dimen/hy_lay_dp_37"/>
                        <TextView
                            android:textSize="@dimen/hy_font_sp_24"
                            android:textColor="#3D3D3D"
                            android:layout_marginLeft="@dimen/hy_lay_dp_21"
                            android:text="湿度"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hy_lay_dp_8">

                        <TextView
                            android:layout_centerHorizontal="true"
                            android:id="@+id/tv_inRoom_humidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="#000000"
                            android:textSize="@dimen/hy_font_sp_60" />

                        <TextView
                            android:layout_centerInParent="true"
                            android:layout_toRightOf="@+id/tv_inRoom_humidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/hy_lay_dp_27"
                            android:text="%"
                            android:textColor="#343A38"
                            android:textSize="@dimen/hy_font_sp_30" />
                    </RelativeLayout>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/hy_lay_dp_15"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="0dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/home_tq_bg"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:layout_marginLeft="@dimen/hy_lay_dp_29"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:src="@drawable/icon_pm"
                            android:layout_width="@dimen/hy_lay_dp_37"
                            android:layout_height="@dimen/hy_lay_dp_38"/>
                        <TextView
                            android:textSize="@dimen/hy_font_sp_24"
                            android:textColor="#3D3D3D"
                            android:layout_marginLeft="@dimen/hy_lay_dp_17"
                            android:text="PM2.5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_marginTop="@dimen/hy_lay_dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_centerHorizontal="true"
                            android:id="@+id/tv_inRoom_pm"
                            android:textColor="#000000"
                            android:textSize="@dimen/hy_font_sp_60"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"/>
                        <TextView
                            android:layout_centerInParent="true"
                            android:layout_toRightOf="@+id/tv_inRoom_pm"
                            android:textColor="#343A38"
                            android:layout_marginLeft="@dimen/hy_lay_dp_26"
                            android:textSize="@dimen/hy_font_sp_30"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ug/m³"/>
                    </RelativeLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginLeft="@dimen/hy_lay_dp_21"
                    android:orientation="vertical"
                    android:background="@drawable/home_tq_bg"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:layout_marginLeft="@dimen/hy_lay_dp_29"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:src="@drawable/icon_co"
                            android:layout_width="@dimen/hy_lay_dp_37"
                            android:layout_height="@dimen/hy_lay_dp_38"/>
                        <TextView
                            android:textSize="@dimen/hy_font_sp_24"
                            android:textColor="#3D3D3D"
                            android:layout_marginLeft="@dimen/hy_lay_dp_28"
                            android:text="CO2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <RelativeLayout
                        android:layout_marginTop="@dimen/hy_lay_dp_8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_centerHorizontal="true"
                            android:textSize="@dimen/hy_font_sp_60"
                            android:id="@+id/tv_inRoom_co2"
                            android:textColor="#000000"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"/>
                        <TextView
                            android:layout_centerInParent="true"
                            android:layout_toRightOf="@+id/tv_inRoom_co2"
                            android:textColor="#343A38"
                            android:layout_marginLeft="@dimen/hy_lay_dp_26"
                            android:textSize="@dimen/hy_font_sp_30"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ppm"/>
                    </RelativeLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:visibility="gone"
            android:id="@+id/ll_caring_mode"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/hy_lay_dp_21"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_menu"
                android:background="@drawable/home_tq_bg"
                android:textSize="@dimen/hy_font_sp_36"
                android:gravity="center"
                android:layout_gravity="center"
                android:text="更多\n操作"
                android:textColor="#000000"
                android:layout_width="match_parent"
                android:layout_weight="1"
                android:layout_height="0dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/close_image"
                android:src="@drawable/selector_shut_down_bg"
                android:layout_width="@dimen/hy_lay_dp_142"
                android:layout_weight="1"
                android:layout_height="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_classic_mode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/hy_lay_dp_33"
            android:layout_marginTop="@dimen/hy_lay_dp_10"
            android:layout_marginBottom="@dimen/hy_lay_dp_13"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/bt_timing"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/home_btn_switch_bg">

                <TextView
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/hy_lay_dp_31"
                    android:text="定时"
                    android:textSize="@dimen/hy_font_sp_24" />

                <TextView
                    android:textSize="@dimen/hy_font_sp_18"
                    android:id="@+id/tv_timing"
                    android:textColor="@drawable/selector_btn_text_color"
                    android:button="@null"
                    android:gravity="center"
                    android:background="@drawable/home_switch_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/hy_lay_dp_26"
                    android:text="关" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bt_locking"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/hy_lay_dp_10"
                android:layout_weight="1"
                android:background="@drawable/home_btn_switch_bg">

                <TextView
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/hy_lay_dp_31"
                    android:text="童锁"
                    android:textSize="@dimen/hy_font_sp_24" />

                <TextView
                    android:textSize="@dimen/hy_font_sp_18"
                    android:id="@+id/tv_locking"
                    android:textColor="@drawable/selector_btn_text_color"
                    android:button="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/hy_lay_dp_26"
                    android:background="@drawable/home_switch_bg"
                    android:gravity="center"
                    android:text="关" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/close_tv"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/hy_lay_dp_10"
                android:layout_weight="1"
                android:background="@drawable/home_btn_switch_bg">

                <TextView
                    android:textColor="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/hy_lay_dp_31"
                    android:text="开关"
                    android:textSize="@dimen/hy_font_sp_24" />

                <TextView
                    android:textSize="@dimen/hy_font_sp_18"
                    android:textColor="@drawable/selector_btn_text_color"
                    android:button="@null"
                    android:id="@+id/tv_switch"
                    android:gravity="center"
                    android:background="@drawable/home_switch_bg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/hy_lay_dp_26"
                    android:text="关" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/radio_group1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hy_lay_dp_60"
            android:layout_marginLeft="@dimen/hy_lay_dp_12"
            android:layout_marginTop="@dimen/hy_lay_dp_35"
            android:layout_marginRight="@dimen/hy_lay_dp_23"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_marginLeft="@dimen/hy_lay_dp_10"
                android:id="@+id/bt_runMode"
                android:layout_width="@dimen/hy_lay_dp_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/selector_lay_bg"
                android:paddingLeft="@dimen/hy_lay_dp_30">
                <ImageView
                    android:id="@+id/image_runMode"
                    android:tint="@drawable/selector_btn_text_color"
                    android:layout_width="@dimen/hy_lay_dp_31"
                    android:layout_height="@dimen/hy_lay_dp_31"
                    android:src="@drawable/select_auto"
                    android:contentDescription="自动图标" />
                <TextView
                    android:id="@+id/tv_runMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/hy_lay_dp_13"
                    android:text="自动"
                    android:textSize="@dimen/hy_font_sp_20"
                    android:textColor="@drawable/selector_btn_text_color" />
            </LinearLayout>


            <LinearLayout
                android:layout_marginLeft="@dimen/hy_lay_dp_24"
                android:id="@+id/ll_refrigeration"
                android:layout_width="@dimen/hy_lay_dp_0"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/selector_lay_bg"
                android:paddingLeft="@dimen/hy_lay_dp_30">
                <ImageView
