<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/item_roomName"
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="客厅"
        android:textColor="@color/baseTextColor"
        android:textSize="24sp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="#ff292b34"
        android:gravity="center"
       >

        <TextView
            android:id="@+id/item_temp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="26"
            android:textColor="@color/baseTextColor"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/item_humidity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="50"
            android:textColor="@color/baseTextColor"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/item_pm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="50"
            android:textColor="@color/baseTextColor"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/item_co2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="24"
            android:textColor="@color/baseTextColor"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/item_airValve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="关"
            android:textColor="@color/baseTextColor"
            android:textSize="24sp" />

    </LinearLayout>


</LinearLayout>