<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0EA"
    android:orientation="horizontal"
    android:padding="@dimen/hy_lay_dp_15">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical"
        android:padding="@dimen/hy_lay_dp_16">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/fan_test_title"
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_26" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hy_lay_dp_30"
            android:text="设备安装类型："
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_20" />

        <RadioGroup
            android:id="@+id/type_rg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hy_lay_dp_60"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/type1_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="柜机"
                android:textColor="#000"
                android:textSize="@dimen/hy_font_sp_20" />

            <RadioButton
                android:id="@+id/type2_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_16"
                android:text="吊顶机"
                android:textColor="#000"
                android:textSize="@dimen/hy_font_sp_20" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hy_lay_dp_16"
            android:text="设备安装型号："
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_20" />

        <com.hy.greenbuilding.ui.widget.FlowRadioGroup
            android:id="@+id/model_rg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/model1_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="36"
                android:textColor="#000"
                android:textSize="@dimen/hy_font_sp_20" />

            <RadioButton
                android:id="@+id/model2_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_16"
                android:text="52"
                android:textColor="#000"
                android:textSize="@dimen/hy_font_sp_20" />

            <RadioButton
                android:id="@+id/model3_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_16"
                android:text="72"
                android:textColor="#000"
                android:textSize="@dimen/hy_font_sp_20" />

            <RadioButton
                android:id="@+id/model4_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_16"
                android:text="100"
                android:textColor="#000"
                android:textSize="@dimen/hy_font_sp_20" />

            <RadioButton
                android:id="@+id/model5_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_16"
                android:text="125"
                android:textColor="#000"
                android:textSize="@dimen/hy_font_sp_20" />
        </com.hy.greenbuilding.ui.widget.FlowRadioGroup>

    </LinearLayout>


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/hy_lay_dp_15"
        android:layout_weight="5"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/li_back"
            android:layout_width="@dimen/li_return_image"
            android:layout_height="@dimen/li_return_image"
            android:gravity="center"
            android:padding="@dimen/hy_lay_dp_15"
            android:src="@drawable/icon_return"
            android:tint="#000" />


        <FrameLayout
            android:id="@+id/fragment_content1"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </LinearLayout>


</LinearLayout>