<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/hy_lay_dp_17"
    android:layout_marginTop="@dimen/hy_lay_dp_20"
    android:layout_marginRight="@dimen/hy_lay_dp_17"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingLeft="@dimen/hy_lay_dp_55"
    android:id="@+id/in_filter_screen_module1"
    android:paddingTop="@dimen/hy_lay_dp_20"
    android:paddingRight="@dimen/hy_lay_dp_55"
    android:paddingBottom="@dimen/hy_lay_dp_20">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hy_lay_dp_8"
            android:text="滤网时间设置"
            android:textColor="#3D3D3D"
            android:textSize="@dimen/hy_font_sp_18" />


        <CheckBox
            android:layout_marginLeft="@dimen/hy_lay_dp_56"
            style="@style/mycheckbox"
            android:id="@+id/new_wind_time_cb"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/circular_checkbox_selector"
            android:drawablePadding="6dp"
            android:text="新风"
            android:textColor="#343A38"
            android:textSize="@dimen/hy_font_sp_22" />

        <CheckBox
            android:layout_marginLeft="@dimen/hy_lay_dp_56"
            android:id="@+id/exhaust_time_cb"
            style="@style/mycheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="排风"
            android:textColor="#343A38"
            android:textSize="@dimen/hy_font_sp_22" />

        <CheckBox
            android:layout_marginLeft="@dimen/hy_lay_dp_56"
            android:id="@+id/circle1_time_cb"
            style="@style/mycheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="内循环1"
            android:textColor="#343A38"
            android:textSize="@dimen/hy_font_sp_22" />

        <CheckBox
            android:layout_marginLeft="@dimen/hy_lay_dp_56"
            android:id="@+id/circle2_time_cb"
            style="@style/mycheckbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="内循环2"
            android:textColor="#343A38"
            android:textSize="@dimen/hy_font_sp_22" />

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/hy_lay_dp_66"
        android:layout_marginTop="@dimen/hy_lay_dp_24"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fresh_air"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />


            <TextView
                android:id="@+id/use_freshAir_hour"
                android:layout_width="@dimen/hy_lay_dp_80"
                android:layout_height="@dimen/hy_lay_dp_31"
                android:layout_marginStart="@dimen/hy_lay_dp_15"
                android:textColor="#000"
                android:background="@drawable/rounded_border_bg"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_15"
                android:text="@string/time_hour"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12"
                android:theme="@style/baseTextTheme1" />

            <Button
                android:id="@+id/use_freshAir_reset"
                android:layout_width="@dimen/hy_lay_dp_53"
                android:layout_height="@dimen/hy_lay_dp_28"
                android:layout_marginLeft="@dimen/hy_lay_dp_20"
                android:background="@drawable/button_style_bg"
                android:text="@string/reset"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/hy_font_sp_12" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/circle_wind1"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12"
                android:theme="@style/baseTextTheme1" />

            <TextView
                android:textColor="#000"
                android:id="@+id/use_circle1_hour"
                android:layout_width="@dimen/hy_lay_dp_80"
                android:layout_height="@dimen/hy_lay_dp_31"
                android:layout_marginStart="@dimen/hy_lay_dp_15"
                android:background="@drawable/rounded_border_bg"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_15"
                android:text="@string/time_hour"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />

            <Button
                android:id="@+id/use_circle1_reset"
                android:layout_width="@dimen/hy_lay_dp_53"
                android:layout_height="@dimen/hy_lay_dp_28"
                android:layout_marginLeft="@dimen/hy_lay_dp_20"
                android:background="@drawable/button_style_bg"
                android:text="@string/reset"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/hy_font_sp_12" />
        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/hy_lay_dp_66"
        android:layout_marginTop="@dimen/hy_lay_dp_16"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exhaust"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12"
                android:theme="@style/baseTextTheme1" />

            <TextView
                android:textColor="#000"
                android:id="@+id/use_exhaust_hour"
                android:layout_width="@dimen/hy_lay_dp_80"
                android:layout_height="@dimen/hy_lay_dp_31"
                android:layout_marginStart="@dimen/hy_lay_dp_15"
                android:background="@drawable/rounded_border_bg"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_15"
                android:text="@string/time_hour"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />

            <Button
                android:id="@+id/use_exhaust_reset"
                android:layout_width="@dimen/hy_lay_dp_53"
                android:layout_height="@dimen/hy_lay_dp_28"
                android:layout_marginLeft="@dimen/hy_lay_dp_20"
                android:background="@drawable/button_style_bg"
                android:text="@string/reset"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/hy_font_sp_12" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/circle_wind2"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />

            <TextView
                android:textColor="#000"
                android:id="@+id/use_circle2_hour"
                android:layout_width="@dimen/hy_lay_dp_80"
                android:layout_height="@dimen/hy_lay_dp_31"
                android:layout_marginStart="@dimen/hy_lay_dp_15"
                android:background="@drawable/rounded_border_bg"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_15"
                android:text="@string/time_hour"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12"
                android:theme="@style/baseTextTheme1" />

            <Button
                android:id="@+id/use_circle2_reset"
                android:layout_width="@dimen/hy_lay_dp_53"
                android:layout_height="@dimen/hy_lay_dp_28"
                android:layout_marginLeft="@dimen/hy_lay_dp_20"
                android:background="@drawable/button_style_bg"
                android:text="@string/reset"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/hy_font_sp_12" />
        </LinearLayout>


    </LinearLayout>


    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hy_lay_dp_8"
        android:layout_marginTop="@dimen/hy_lay_dp_29"
        android:text="@string/change_filter_screen"
        android:textColor="#3D3D3D"
        android:textSize="@dimen/hy_font_sp_18" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/hy_lay_dp_66"
        android:layout_marginTop="@dimen/hy_lay_dp_20"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fresh_air"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />

            <EditText
                android:textColor="#000"
                android:id="@+id/change_freshAir_hour"
                android:layout_width="@dimen/hy_lay_dp_80"
                android:layout_height="@dimen/hy_lay_dp_31"
                android:layout_marginStart="@dimen/hy_lay_dp_8"
                android:background="@drawable/rounded_border_bg"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_8"
                android:text="@string/time_hour"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />

            <TextView
                android:id="@+id/freshAir_screen_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_filterScreen_info"
                android:textColor="#AE8567"
                android:textSize="@dimen/hy_font_sp_10"
                android:visibility="invisible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/circle_wind1"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />

            <EditText
                android:textColor="#000"
                android:id="@+id/change_circle1_hour"
                android:layout_width="@dimen/hy_lay_dp_80"
                android:layout_height="@dimen/hy_lay_dp_31"
                android:layout_marginStart="@dimen/hy_lay_dp_8"
                android:background="@drawable/rounded_border_bg"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_8"
                android:text="@string/time_hour"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />

            <TextView
                android:id="@+id/circle1_screen_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_filterScreen_info"
                android:textColor="#AE8567"
                android:textSize="@dimen/hy_font_sp_10"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"

        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/hy_lay_dp_66"
        android:layout_marginTop="@dimen/hy_lay_dp_18"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exhaust"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />

            <EditText
                android:textColor="#000"
                android:id="@+id/change_exhaust_hour"
                android:layout_width="@dimen/hy_lay_dp_80"
                android:layout_height="@dimen/hy_lay_dp_31"
                android:layout_marginStart="@dimen/hy_lay_dp_8"
                android:background="@drawable/rounded_border_bg"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_8"
                android:text="@string/time_hour"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />

            <TextView
                android:id="@+id/exhaust_screen_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_filterScreen_info"
                android:textColor="#AE8567"
                android:textSize="@dimen/hy_font_sp_10"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/circle_wind2"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />

            <EditText
                android:textColor="#000"
                android:id="@+id/change_circle2_hour"
                android:layout_width="@dimen/hy_lay_dp_80"
                android:layout_height="@dimen/hy_lay_dp_31"
                android:layout_marginStart="@dimen/hy_lay_dp_8"
                android:background="@drawable/rounded_border_bg"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hy_lay_dp_8"
                android:text="@string/time_hour"
                android:textColor="#3D3D3D"
                android:textSize="@dimen/hy_font_sp_12" />

            <TextView
                android:id="@+id/circle2_screen_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_filterScreen_info"
                android:textColor="#AE8567"
                android:textSize="@dimen/hy_font_sp_10"
                android:visibility="invisible" />
        </LinearLayout>


    </LinearLayout>
</LinearLayout>