<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0EA"
    android:orientation="vertical"
    android:paddingStart="@dimen/hy_lay_dp_32"
    android:paddingTop="@dimen/hy_lay_dp_16"
    android:paddingEnd="@dimen/hy_lay_dp_32"
    android:paddingBottom="@dimen/hy_lay_dp_16">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hy_lay_dp_100"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/li_back"
            android:layout_width="@dimen/li_return_image"
            android:layout_height="@dimen/li_return_image"
            android:gravity="center"
            android:padding="@dimen/hy_lay_dp_15"
            android:src="@drawable/icon_return"
            android:tint="#000"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="滤网设置"
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_30" />

    </RelativeLayout>

    <LinearLayout
        android:layout_marginLeft="@dimen/hy_lay_dp_68"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:text="滤网"
            android:textSize="@dimen/hy_font_sp_40"
            android:textColor="#000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_gravity="center"
            android:text="时间设置"
            android:layout_marginLeft="@dimen/hy_lay_dp_31"
            android:paddingTop="@dimen/hy_lay_dp_6"
            android:paddingBottom="@dimen/hy_lay_dp_6"
            android:paddingLeft="@dimen/hy_lay_dp_16"
            android:paddingRight="@dimen/hy_lay_dp_16"
            android:id="@+id/tv_li_filterScreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/hy_font_sp_20"
            android:background="@drawable/text_bg"
            android:textColor="@drawable/selector_btn_text_color"
            />

        <TextView
            android:layout_gravity="center"
            android:text="压差设置"
            android:layout_marginLeft="@dimen/hy_lay_dp_31"
            android:paddingTop="@dimen/hy_lay_dp_6"
            android:paddingBottom="@dimen/hy_lay_dp_6"
            android:paddingLeft="@dimen/hy_lay_dp_16"
            android:paddingRight="@dimen/hy_lay_dp_16"
            android:id="@+id/tv_pressure_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/hy_font_sp_20"
            android:background="@drawable/text_bg"
            android:textColor="@drawable/selector_btn_text_color"
            />
    </LinearLayout>

    <include layout="@layout/filter_screen_module1" />

    <include layout="@layout/filter_screen_module3"  />

</LinearLayout>