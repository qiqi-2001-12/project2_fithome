<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0EA"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:background="@drawable/main_left_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/hy_lay_dp_24"
        android:paddingTop="@dimen/hy_lay_dp_24"
        android:paddingEnd="@dimen/hy_lay_dp_16">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择除霜模式"
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_24" />

        <RadioGroup
            android:id="@+id/radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hy_lay_dp_10"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/normal_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0标准除霜"
                android:textColor="#000"
                android:textSize="@dimen/hy_font_sp_26" />

            <RadioButton
                android:id="@+id/other_rb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hy_lay_dp_10"
                android:text="汉唐除霜"
                android:textColor="#000"
                android:textSize="@dimen/hy_font_sp_26" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hy_lay_dp_36"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="压缩机型号"
                android:textColor="#000"

                android:textSize="@dimen/hy_font_sp_22" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hy_lay_dp_8"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_frequency_model"
                    android:layout_width="@dimen/hy_lay_dp_100"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:inputType="number"
                    android:background="@drawable/rounded_border_bg"
                    android:textColor="#000"
                    android:theme="@style/baseTextTheme"
                    android:textSize="@dimen/hy_font_sp_22" />

                <Button
                    android:textColor="#fff"
                    android:id="@+id/bt_frequency_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/hy_lay_dp_10"
                    android:background="@drawable/button_style_bg"
                    android:padding="@dimen/hy_lay_dp_8"
                    android:text="@string/setting_txt"
                    android:theme="@style/baseTextTheme1" />

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hy_lay_dp_10"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="室外机驱动类型"
                android:textColor="#000"

                android:textSize="@dimen/hy_font_sp_22" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hy_lay_dp_8"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_drive_type"
                    android:layout_width="@dimen/hy_lay_dp_100"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:inputType="number"
                    android:textColor="#000"
                    android:background="@drawable/rounded_border_bg"
                    android:layout_gravity="center"
                    android:textSize="@dimen/hy_font_sp_22"
                    android:theme="@style/baseTextTheme" />

                <Button
                    android:textColor="#fff"
                    android:id="@+id/bt_drive_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/hy_lay_dp_10"
                    android:background="@drawable/button_style_bg"
                    android:padding="@dimen/hy_lay_dp_8"
                    android:text="@string/setting_txt"
                    android:theme="@style/baseTextTheme1" />
            </LinearLayout>


        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5"
        android:background="@drawable/main_left_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/hy_lay_dp_100"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/li_back"

                android:tint="#000"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/icon_return" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="测试模式"
                android:textColor="#000"

                android:textSize="@dimen/hy_font_sp_30" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_tq_bg"
                android:orientation="vertical"
                android:padding="@dimen/hy_lay_dp_16">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hy_lay_dp_36"
                    android:gravity="center"
                    android:text="室外机设置"
                    android:textColor="#000"

                    android:textSize="@dimen/hy_font_sp_26" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/hy_lay_dp_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_gravity="center"
                            android:id="@+id/tv1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="手动频率"
                            android:textColor="#000"

                            android:textSize="@dimen/hy_font_sp_22"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <EditText
                            android:layout_marginRight="@dimen/hy_lay_dp_10"
                            android:layout_marginLeft="@dimen/hy_lay_dp_10"
                            android:background="@drawable/rounded_border_bg"
                            android:layout_gravity="center"
                            android:id="@+id/manual_frequency_et"
                            android:layout_width="@dimen/hy_lay_dp_100"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:inputType="number"
                            android:textColor="#000"

                            android:textSize="@dimen/hy_font_sp_22"
                            android:theme="@style/myEditText"
                            app:layout_constraintStart_toEndOf="@+id/tv1"
                            app:layout_constraintTop_toTopOf="parent" />

                        <Button
                            android:id="@+id/manual_frequency_bt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:background="@drawable/button_style_bg"
                            android:padding="@dimen/hy_lay_dp_8"
                            android:text="@string/setting_txt"
                            android:textColor="#fff"
                            android:theme="@style/baseTextTheme1" />

                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hy_lay_dp_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="主路EEV模式"
                                android:textColor="#000"

                                android:textSize="22sp" />

                            <EditText
                                android:layout_marginRight="@dimen/hy_lay_dp_10"
                                android:layout_marginLeft="@dimen/hy_lay_dp_10"
                                android:background="@drawable/rounded_border_bg"
                                android:id="@+id/main_eev_model_et"
                                android:layout_width="@dimen/hy_lay_dp_100"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:textColor="#000"
                                android:textSize="@dimen/hy_font_sp_22"
                                android:theme="@style/myEditText" />

                            <Button
                                android:id="@+id/main_eev_model_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/button_style_bg"
                                android:padding="@dimen/hy_lay_dp_8"
                                android:text="@string/setting_txt"
                                android:textColor="#fff"
                                android:theme="@style/baseTextTheme1" />
                        </LinearLayout>

                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="辅助EEV模式"
                                android:textColor="#000"

                                android:textSize="22sp" />

                            <EditText
                                android:layout_marginRight="@dimen/hy_lay_dp_10"
                                android:layout_marginLeft="@dimen/hy_lay_dp_10"
                                android:background="@drawable/rounded_border_bg"
                                android:id="@+id/aux_eev_model_et"
                                android:layout_width="@dimen/hy_lay_dp_100"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:textColor="#000"

                                android:textSize="@dimen/hy_font_sp_22"
                                android:theme="@style/myEditText" />

                            <Button
                                android:textColor="#fff"
                                android:id="@+id/aux_eev_model_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/button_style_bg"
                                android:padding="@dimen/hy_lay_dp_8"
                                android:text="@string/setting_txt"
                                android:theme="@style/baseTextTheme1" />
                        </LinearLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hy_lay_dp_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="主路EEV初开度"
                                android:textColor="#000"

                                android:textSize="22sp" />

                            <EditText
                                android:layout_marginRight="@dimen/hy_lay_dp_10"
                                android:layout_marginLeft="@dimen/hy_lay_dp_10"
                                android:id="@+id/main_eev_open1_et"
                                android:layout_width="@dimen/hy_lay_dp_100"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:textColor="#000"
                                android:background="@drawable/rounded_border_bg"
                                android:textSize="@dimen/hy_font_sp_22"
                                android:theme="@style/myEditText" />

                            <Button
                                android:id="@+id/main_eev_open1_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/button_style_bg"
                                android:padding="@dimen/hy_lay_dp_8"
                                android:text="@string/setting_txt"
                                android:textColor="#fff"
                                android:theme="@style/baseTextTheme1" />
                        </LinearLayout>

                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="辅助EEV初开度"
                                android:textColor="#000"

                                android:textSize="22sp" />

                            <EditText
                                android:layout_marginRight="@dimen/hy_lay_dp_10"
                                android:layout_marginLeft="@dimen/hy_lay_dp_10"
                                android:background="@drawable/rounded_border_bg"
                                android:id="@+id/aux_eev_open1_et"
                                android:layout_width="@dimen/hy_lay_dp_100"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:textColor="#000"

                                android:textSize="@dimen/hy_font_sp_22"
                                android:theme="@style/myEditText" />

                            <Button
                                android:textColor="#fff"
                                android:id="@+id/aux_eev_open1_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/button_style_bg"
                                android:padding="@dimen/hy_lay_dp_8"
                                android:text="@string/setting_txt"
                                android:theme="@style/baseTextTheme1" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hy_lay_dp_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="直流风机数量"
                                android:textColor="#000"

                                android:textSize="22sp" />

                            <EditText
                                android:layout_marginRight="@dimen/hy_lay_dp_10"
                                android:layout_marginLeft="@dimen/hy_lay_dp_10"
                                android:id="@+id/fan_num_et"
                                android:layout_width="@dimen/hy_lay_dp_100"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:textColor="#000"
                                android:background="@drawable/rounded_border_bg"
                                android:textSize="@dimen/hy_font_sp_22"
                                android:theme="@style/myEditText" />

                            <Button
                                android:id="@+id/fan_num_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/button_style_bg"
                                android:padding="@dimen/hy_lay_dp_8"
                                android:text="@string/setting_txt"
                                android:textColor="#fff"
                                android:theme="@style/baseTextTheme1" />
                        </LinearLayout>

                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="辅助EEV最小开度"
                                android:textColor="#000"

                                android:textSize="22sp" />

                            <EditText
                                android:background="@drawable/rounded_border_bg"
                                android:id="@+id/aux_eev_min_et"
                                android:layout_width="@dimen/hy_lay_dp_100"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:textColor="#000"
                                android:layout_marginRight="@dimen/hy_lay_dp_10"
                                android:layout_marginLeft="@dimen/hy_lay_dp_10"
                                android:textSize="22sp"
                                android:theme="@style/myEditText" />

                            <Button
                                android:textColor="#fff"
                                android:id="@+id/aux_eev_min_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/button_style_bg"
                                android:padding="@dimen/hy_lay_dp_8"
                                android:text="@string/setting_txt"
                                android:theme="@style/baseTextTheme1" />
                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hy_lay_dp_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="直流风机最高转速"
                                android:textColor="#000"

                                android:textSize="22sp" />

                            <EditText
                                android:layout_marginRight="@dimen/hy_lay_dp_10"
                                android:layout_marginLeft="@dimen/hy_lay_dp_10"
                                android:id="@+id/speed_max_et"
                                android:layout_width="@dimen/hy_lay_dp_100"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:textColor="#000"
                                android:background="@drawable/rounded_border_bg"
                                android:textSize="22sp"
                                android:theme="@style/myEditText" />

                            <Button
                                android:id="@+id/speed_max_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/button_style_bg"
                                android:padding="@dimen/hy_lay_dp_8"
                                android:text="@string/setting_txt"
                                android:textColor="#fff"
                                android:theme="@style/baseTextTheme1" />
                        </LinearLayout>

                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="直流风机最低转速"
                                android:textColor="#000"

                                android:textSize="22sp" />

                            <EditText
                                android:id="@+id/speed_min_et"
                                android:layout_width="@dimen/hy_lay_dp_100"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:textColor="#000"
                                android:layout_marginRight="@dimen/hy_lay_dp_10"
                                android:layout_marginLeft="@dimen/hy_lay_dp_10"
                                android:background="@drawable/rounded_border_bg"
                                android:textSize="22sp"
                                android:theme="@style/myEditText" />

                            <Button
                                android:textColor="#fff"
                                android:id="@+id/speed_min_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/button_style_bg"
                                android:padding="@dimen/hy_lay_dp_8"
                                android:text="@string/setting_txt"
                                android:theme="@style/baseTextTheme1" />
                        </LinearLayout>


                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hy_lay_dp_16"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="手动风机使能"
                                android:textColor="#000"

                                android:textSize="22sp" />

                            <EditText
                                android:layout_marginRight="@dimen/hy_lay_dp_10"
                                android:layout_marginLeft="@dimen/hy_lay_dp_10"
                                android:id="@+id/fan_action_et"
                                android:layout_width="@dimen/hy_lay_dp_100"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:textColor="#000"
                                android:background="@drawable/rounded_border_bg"
                                android:textSize="@dimen/hy_font_sp_22"
                                android:theme="@style/myEditText" />

                            <Button
                                android:id="@+id/fan_action_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/button_style_bg"
                                android:padding="@dimen/hy_lay_dp_8"
                                android:text="@string/setting_txt"
                                android:textColor="#fff"
                                android:theme="@style/baseTextTheme1" />
                        </LinearLayout>

                        <LinearLayout
                            android:gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="风机手动转速"
                                android:textColor="#000"

                                android:textSize="22sp" />

                            <EditText
                                android:layout_marginRight="@dimen/hy_lay_dp_10"
                                android:layout_marginLeft="@dimen/hy_lay_dp_10"
                                android:id="@+id/fan_speed_et"
                                android:layout_width="@dimen/hy_lay_dp_100"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:textColor="#000"
                                android:background="@drawable/rounded_border_bg"
                                android:textSize="@dimen/hy_font_sp_22"
                                android:theme="@style/myEditText" />

                            <Button
                                android:textColor="#fff"
                                android:id="@+id/fan_speed_bt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@drawable/button_style_bg"
                                android:padding="@dimen/hy_lay_dp_8"
                                android:text="@string/setting_txt"
                                android:theme="@style/baseTextTheme1" />

                        </LinearLayout>
                    </LinearLayout>


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/hy_lay_dp_16"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="命令输入"
                        android:textColor="#000"

                        android:textSize="22sp" />

                    <EditText
                        android:layout_marginRight="@dimen/hy_lay_dp_10"
                        android:layout_marginLeft="@dimen/hy_lay_dp_10"
                        android:id="@+id/common_data_et"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center|start"
                        android:inputType="text"
                        android:paddingStart="@dimen/hy_lay_dp_16"
                        android:singleLine="true"
                        android:textColor="#000"
                        android:background="@drawable/rounded_border_bg"
                        android:textSize="@dimen/hy_font_sp_22"
                        android:theme="@style/baseTextTheme" />


                    <Button
                        android:textColor="#fff"
                        android:id="@+id/common_data_bt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_style_bg"
                        android:padding="@dimen/hy_lay_dp_8"
                        android:text="发送"
                        android:theme="@style/baseTextTheme1" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/hy_lay_dp_16"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
