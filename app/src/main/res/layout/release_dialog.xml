<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_left_bg"
    android:gravity="center"
    >

    <TextView
        android:id="@+id/room_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:textColor="#000000"
        android:text="确认解除绑定"
        android:textSize="28sp"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:orientation="horizontal"
        android:gravity="center"
        >
        <Button
            android:id="@+id/bt_negative"
            android:layout_width="130dp"
            android:layout_height="50dp"
            android:text="取消"
            android:textColor="#fff"
            android:theme="@style/baseTextTheme1"
            android:background="@drawable/btn_bg_common1"
            />
        <Button
            android:textColor="#fff"
            android:id="@+id/bt_positive"
            android:layout_width="130dp"
            android:layout_height="50dp"
            android:background="@drawable/button_style_bg"
            android:theme="@style/baseTextTheme1"
            android:layout_marginStart="50dp"
            android:text="确定"
            />
    </LinearLayout>

</LinearLayout>