<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0EA"
    android:orientation="vertical"
    android:paddingStart="@dimen/hy_lay_dp_32"
    android:paddingTop="@dimen/hy_lay_dp_16"
    android:paddingEnd="@dimen/hy_lay_dp_32"
    android:paddingBottom="@dimen/hy_lay_dp_16">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hy_lay_dp_100"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/li_back"
            android:layout_width="@dimen/li_return_image"
            android:layout_height="@dimen/li_return_image"
            android:gravity="center"
            android:padding="@dimen/hy_lay_dp_15"
            android:src="@drawable/icon_return"
            android:tint="#000"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="膨胀阀设置"
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_30" />

    </RelativeLayout>


    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/hy_font_sp_30"
                android:theme="@style/baseTextTheme"
                android:text="升温除湿类型"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_marginTop="@dimen/hy_lay_dp_20"
                android:textSize="@dimen/hy_font_sp_30"
                android:theme="@style/baseTextTheme"
                android:text="风机小板"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioGroup
                android:id="@+id/radio_group_type"
                android:layout_marginLeft="@dimen/hy_lay_dp_82"
                android:gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="0dp">
                <RadioButton
                    android:button="@drawable/radio_button_selector"
                    android:paddingLeft="@dimen/hy_lay_dp_18"
                    android:id="@+id/rb_type_4p"
                    android:textSize="@dimen/hy_font_sp_28"
                    android:textColor="#000"
                    android:text="4P"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
                <RadioButton
                    android:button="@drawable/radio_button_selector"
                    android:paddingLeft="@dimen/hy_lay_dp_18"
                    android:layout_marginLeft="@dimen/hy_lay_dp_114"
                    android:id="@+id/rb_type_2p3p"
                    android:textSize="@dimen/hy_font_sp_28"
                    android:textColor="#000"
                    android:theme="@style/baseTextTheme"
                    android:text="2P/3P"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </RadioGroup>

            <RadioGroup
                android:id="@+id/radio_group_xb"
                android:layout_marginTop="@dimen/hy_lay_dp_20"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:layout_marginLeft="@dimen/hy_lay_dp_82"
                android:layout_width="wrap_content"
                android:gravity="center"
                android:layout_height="0dp">
                <RadioButton
                    android:paddingLeft="@dimen/hy_lay_dp_18"
                    android:id="@+id/rb_fan_board_1"
                    android:textSize="@dimen/hy_font_sp_28"
                    android:textColor="#000"
                    android:text="风机板1(旧)"
                    android:button="@drawable/radio_button_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
                <RadioButton
                    android:button="@drawable/radio_button_selector"
                    android:layout_marginLeft="@dimen/hy_lay_dp_50"
                    android:paddingLeft="@dimen/hy_lay_dp_18"
                    android:id="@+id/rb_fan_board_2"
                    android:textSize="@dimen/hy_font_sp_28"
                    android:textColor="#000"
                    android:text="风机板2(新)"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"/>
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="@dimen/hy_lay_dp_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/expansion_valve_settings_layout" />
        <include layout="@layout/expansion_valve_settings_layout2" />
    </LinearLayout>
</LinearLayout>