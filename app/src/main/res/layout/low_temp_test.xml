<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0EA"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="776dp"
        android:layout_weight="2"
        android:background="@drawable/main_left_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/hy_lay_dp_20">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/function_test"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_30" />

        <LinearLayout
            android:layout_width="270dp"
            android:layout_height="650dp"
            android:layout_marginTop="@dimen/hy_lay_dp_30"
            android:background="@drawable/home_tq_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="550dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingTop="@dimen/hy_lay_dp_5"
                    android:orientation="vertical">

                    <TextView
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:text="制热E"
                        android:textColor="#000"
                        android:theme="@style/baseTextTheme2" />

                    <TextView
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="制热A"
                        android:textColor="#000"
                        android:theme="@style/baseTextTheme2" />

                    <TextView
                        android:gravity="center"
                        android:textColor="#000"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="制热B"
                        android:theme="@style/baseTextTheme2" />

                    <TextView
                        android:gravity="center"
                        android:textColor="#000"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="制热C"
                        android:theme="@style/baseTextTheme2" />

                    <TextView
                        android:gravity="center"
                        android:textColor="#000"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="制热D"
                        android:theme="@style/baseTextTheme2" />

                    <TextView
                        android:gravity="center"
                        android:textColor="#000"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="制冷A"
                        android:theme="@style/baseTextTheme2" />

                    <TextView
                        android:gravity="center"
                        android:textColor="#000"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="制冷B"
                        android:theme="@style/baseTextTheme2"  />

                    <TextView
                        android:gravity="center"
                        android:textColor="#000"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="制冷C"
                        android:theme="@style/baseTextTheme2" />

                    <TextView
                        android:gravity="center"
                        android:textColor="#000"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="制冷D"
                        android:theme="@style/baseTextTheme2" />

                </LinearLayout>

                <RadioGroup
                    android:id="@+id/radiogroup_test"
                    android:layout_width="0dp"
                    android:layout_height="550dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <RadioButton
                        android:buttonTint="#000000"
                        android:id="@+id/rb_hotE"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:text="-20℃"
                        android:theme="@style/baseTextTheme2" />

                    <RadioButton
                        android:buttonTint="#000000"
                        android:id="@+id/rb_hotA"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="-12℃"
                        android:theme="@style/baseTextTheme2" />

                    <RadioButton
                        android:id="@+id/rb_hotB"
                        android:buttonTint="#000000"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="-7℃"
                        android:theme="@style/baseTextTheme2" />

                    <RadioButton
                        android:buttonTint="#000000"
                        android:id="@+id/rb_hotC"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="2℃"
                        android:theme="@style/baseTextTheme2" />

                    <RadioButton
                        android:buttonTint="#000000"
                        android:id="@+id/rb_hotD"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="7℃"
                        android:theme="@style/baseTextTheme2" />

                    <RadioButton
                        android:buttonTint="#000000"
                        android:id="@+id/rb_coldA"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="25℃"
                        android:theme="@style/baseTextTheme2" />

                    <RadioButton
                        android:buttonTint="#000000"
                        android:id="@+id/rb_coldB"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="30℃"
                        android:theme="@style/baseTextTheme2" />

                    <RadioButton
                        android:buttonTint="#000000"
                        android:id="@+id/rb_coldC"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="35℃"
                        android:theme="@style/baseTextTheme2" />

                    <RadioButton
                        android:buttonTint="#000000"
                        android:id="@+id/rb_coldD"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/hy_lay_dp_30"
                        android:layout_marginTop="@dimen/hy_lay_dp_20"
                        android:text="43℃"
                        android:theme="@style/baseTextTheme2" />

                </RadioGroup>

            </LinearLayout>

            <Button
                android:id="@+id/bt_function_test"
                android:layout_width="150dp"
                android:layout_height="70dp"
                android:text="@string/function_test"
                android:background="@drawable/button_style_bg"
                android:theme="@style/baseTextTheme1"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/hy_lay_dp_15"
                android:textColor="#fff"
                />

        </LinearLayout>


    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="776dp"
        android:layout_weight="5"
        android:background="@drawable/main_left_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hy_font_sp_30"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/li_back"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:gravity="center"
                >
                <ImageView
                    android:tint="#000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_return"
                    />
            </LinearLayout>

            <Button
                android:background="@drawable/button_style_bg"
                android:id="@+id/bt_force_flu"
                android:layout_width="@dimen/hy_lay_dp_130"
                android:layout_height="60dp"
                android:layout_marginStart="@dimen/hy_lay_dp_20"
                android:text="@string/force_flu"
                android:textColor="#fff"
                android:theme="@style/baseTextTheme1" />

            <Button
                android:id="@+id/bt_force_defrost"
                android:layout_width="@dimen/hy_lay_dp_130"
                android:layout_height="60dp"
                android:layout_marginStart="@dimen/hy_lay_dp_30"
                android:textColor="#fff"
                android:background="@drawable/button_style_bg"
                android:text="@string/force_defrost"
                android:theme="@style/baseTextTheme1" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/hy_lay_dp_0"
            android:text="@string/test_environment"
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_30" />


        <LinearLayout
            android:layout_width="864dp"
            android:layout_height="460dp"
            android:layout_marginTop="@dimen/hy_lay_dp_30"
            android:background="@drawable/home_tq_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:layout_marginTop="@dimen/hy_lay_dp_20"
                android:orientation="horizontal">

                <Button
                    android:textColor="@color/white"
                    android:id="@+id/bt_frequency"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hy_lay_dp_20"
                    android:background="@drawable/button_style_bg"
                    android:text="@string/close_test"
                    android:theme="@style/baseTextTheme1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/hy_lay_dp_15"
                    android:text="压缩机定频"
                    android:textColor="#000"
                    android:textSize="@dimen/hy_font_sp_20" />

                <EditText
                    android:id="@+id/et_frequency"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:theme="@style/myEditText"
                    android:gravity="center"
                    android:inputType="number"
                    android:background="@drawable/edittext_frequency_bg"
                    android:textColor="#000"
                    android:textSize="@dimen/hy_lay_dp_20" />

                <Button
                    android:textColor="@color/white"
                    android:id="@+id/bt_main_valve"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hy_lay_dp_30"
                    android:background="@drawable/button_style_bg"
                    android:text="@string/close_test"
                    android:theme="@style/baseTextTheme1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/main_expansion1"
                    android:textColor="#000"
                    android:textSize="@dimen/hy_font_sp_20" />

                <EditText
                    android:id="@+id/et_main_valve"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:theme="@style/myEditText"
                    android:gravity="center"
                    android:background="@drawable/edittext_frequency_bg"
                    android:inputType="number"
                    android:textColor="#000"
                    android:textSize="@dimen/hy_font_sp_24" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0-240或254)"
                    android:textColor="#000"
                    android:textSize="@dimen/hy_font_sp_20"
                    />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/li_aux_valve"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hy_lay_dp_0"
                android:orientation="horizontal">

                <Button
                    android:textColor="@color/white"
                    android:id="@+id/bt_aux_valve"
                    android:layout_width="100dp"
                    android:layout_height="@dimen/hy_lay_dp_0"
                    android:layout_marginStart="@dimen/hy_lay_dp_20"
                    android:background="@drawable/btn_bg_common1"
                    android:text="@string/close_test"
                    android:theme="@style/baseTextTheme1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hy_lay_dp_15"
                    android:text="@string/aux_expansion"
                    android:textColor="#000"
                    android:textSize="@dimen/hy_font_sp_20" />

                <EditText
                    android:id="@+id/et_aux_valve"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hy_lay_dp_15"
                    android:theme="@style/myEditText"
                    android:inputType="number"
                    android:gravity="center"
                    android:background="@drawable/rounded_border_bg"
                    android:textColor="#000"
                    android:textSize="@dimen/hy_lay_dp_20" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0-240或254)"
                    android:textColor="#000"
                    android:textSize="@dimen/hy_font_sp_20"
                    />

            </LinearLayout>

            <Button
                android:id="@+id/bt_test_commit"
                android:layout_width="150dp"
                android:layout_height="70dp"
                android:layout_marginBottom="@dimen/hy_lay_dp_30"
                android:layout_marginEnd="@dimen/hy_lay_dp_30"
                android:layout_gravity="end"
                android:textColor="#fff"
                android:background="@drawable/button_style_bg"
                android:text="@string/setting_complete"
                android:theme="@style/baseTextTheme" />
        </LinearLayout>

    </LinearLayout>


</LinearLayout>