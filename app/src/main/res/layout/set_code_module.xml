<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F0EA"
    android:orientation="vertical"
    android:paddingStart="@dimen/hy_lay_dp_32"
    android:paddingTop="@dimen/hy_lay_dp_16"
    android:paddingEnd="@dimen/hy_lay_dp_32"
    android:paddingBottom="@dimen/hy_lay_dp_16">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hy_lay_dp_100"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/li_back"
            android:layout_width="@dimen/li_return_image"
            android:layout_height="@dimen/li_return_image"
            android:gravity="center"
            android:padding="@dimen/hy_lay_dp_15"
            android:src="@drawable/icon_return"
            android:tint="#000"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/device_qrCode"
            android:textColor="#000"
            android:textSize="@dimen/hy_font_sp_30" />

        <LinearLayout
            android:layout_marginRight="@dimen/hy_lay_dp_20"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:id="@+id/tv_wifi"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <ImageView
                android:layout_gravity="center"
                android:src="@drawable/wifi"
                android:layout_width="@dimen/hy_lay_dp_44"
                android:layout_height="@dimen/hy_lay_dp_41"/>

            <TextView
                android:textColor="#000"
                android:layout_marginTop="@dimen/hy_lay_dp_13"
                android:text="配网功能"
                android:gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:background="@color/white"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/hy_lay_dp_20"
        android:layout_marginLeft="@dimen/hy_lay_dp_17"
        android:layout_marginRight="@dimen/hy_lay_dp_17"
        android:paddingLeft="@dimen/hy_lay_dp_55"
        android:paddingRight="@dimen/hy_lay_dp_55"
        android:paddingBottom="@dimen/hy_lay_dp_42"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_marginTop="@dimen/hy_lay_dp_76"
            android:layout_marginLeft="@dimen/hy_lay_dp_54"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/device_qrCode"
            android:textColor="#3D3D3D"
            android:textSize="@dimen/hy_font_sp_18"/>

        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_qrCode"
            android:layout_width="@dimen/hy_lay_dp_180"
            android:layout_height="@dimen/hy_lay_dp_180"
            android:scaleType="fitCenter" />
        <TextView
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/hy_lay_dp_11"
            android:textColor="#3D3D3D"
            android:textSize="@dimen/hy_font_sp_18"
            android:id="@+id/tv_mac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>


</LinearLayout>