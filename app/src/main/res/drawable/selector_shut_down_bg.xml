<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中状态：显示选中版图片 -->
    <item android:state_selected="true" android:drawable="@drawable/icon_switch" /> <!-- 替换为你的选中状态图片名 -->

    <!-- 默认状态：显示默认版图片（未选中、已启用） -->
    <item android:drawable="@drawable/icon_switch_no" /> <!-- 替换为你的默认状态图片名 -->
</selector>