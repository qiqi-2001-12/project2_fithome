<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

    </style>


    <style name="baseTextTheme">
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">@dimen/hy_font_sp_24</item>
    </style>

    <style name="baseTextTheme1">
        <item name="android:textColor">#343A38</item>
        <item name="android:textSize">@dimen/hy_font_sp_24</item>
    </style>

    <style name="baseTextTheme2">
        <item name="android:textColor">@color/baseTextColor</item>
        <item name="android:textSize">@dimen/hy_font_sp_20</item>
    </style>

    <style name="myEditText">
        <item name="android:textColor">@color/baseTextColor</item>
        <item name="android:textSize">24sp</item>
        <item name="android:editTextColor">@color/baseTextColor</item>
        <item name="colorControlNormal">@color/baseTextColor</item>
        <item name="colorControlActivated">#000</item>
        <item name="background">@null</item>

<!--        &lt;!&ndash; 关键修复：移除默认的顶部和底部填充 &ndash;&gt;-->
<!--        <item name="android:paddingTop">0dp</item>-->
<!--        <item name="android:paddingBottom">0dp</item>-->

        <!-- 确保文字在较小的高度内垂直居中 -->
        <item name="android:gravity">center_vertical</item>
    </style>


    <style name="DialogFullScreen" parent="Theme.AppCompat.Dialog">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>

    <style name="mycheckbox" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="android:button">@drawable/circular_checkbox_selector</item>
        <item name="android:paddingLeft">10dp</item>
        <!--<item name="android:height">12dp</item>-->
    </style>

    <style name="PopupWindowAnimation">
        <!--        &lt;!&ndash;  弹窗显示时的动画  &ndash;&gt;-->
        <!--        <item name="android:windowEnterAnimation">@anim/popup_exit</item>-->
        <!--        &lt;!&ndash;  弹窗消失时的动画  &ndash;&gt;-->
        <!--        <item name="android:windowExitAnimation">@anim/popup_enter</item>-->
    </style>

    <style name="TabTextStyle">
        <item name="android:textSize">@dimen/hy_font_sp_22</item>
        <item name="android:textColor">@color/tab_text_color_selector</item>
    </style>

    <style name="TouchPopTimeoutButton">
        <item name="android:layout_width">104dp</item>
        <item name="android:layout_height">84dp</item>
        <item name="android:layout_margin">10dp</item>
        <item name="android:background">@drawable/touch_pop_light_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#333333</item>
        <item name="android:textSize">18sp</item>
    </style>
</resources>
