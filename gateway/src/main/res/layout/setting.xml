<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="match_parent"
              android:layout_height="match_parent">

    <ImageView
        android:id="@+id/image_set_return"
        android:layout_width="54dp"
        android:layout_height="55dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="11dp"
        android:layout_weight="1"
        android:background="@drawable/set_return"/>

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/set_bg"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"/>

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="17dp"
        android:text="设置"
        android:textColor="#444348"
        android:textSize="20sp"
        android:textStyle="bold"/>

    <ImageView
        android:id="@+id/image_set_securtiy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/set_security_off"
        android:layout_alignTop="@+id/imageView2"
        android:layout_alignParentStart="true"/>

    <ImageView
        android:id="@+id/image_set_zone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/set_zone_off"
        android:layout_below="@+id/imageView6"
        android:layout_alignParentStart="true"/>

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/set_line_horizontal"
        android:layout_below="@+id/image_set_securtiy"
        android:layout_alignParentStart="true"/>

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/set_line_horizontal"
        android:layout_below="@+id/image_set_zone"
        android:layout_alignParentStart="true"/>

    <ImageView
        android:id="@+id/image_set_wifi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/set_wifi_off"
        android:layout_below="@+id/imageView10"
        android:layout_alignParentStart="true"/>

    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/set_line_horizontal"
        android:layout_below="@+id/image_set_wifi"
        android:layout_alignParentStart="true"/>

    <ImageView
        android:id="@+id/image_set_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/set_language_off"
        android:layout_below="@+id/imageView5"
        android:layout_alignParentStart="true"/>

    <ImageView
        android:id="@+id/imageView10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/set_line_horizontal"
        android:layout_below="@+id/image_set_language"
        android:layout_alignParentStart="true"/>

    <ImageView
        android:id="@+id/image_set_about"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/set_about_off"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"/>

    <ImageView
        android:id="@+id/imageView12"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/set_line_vertical"
        android:layout_alignTop="@+id/imageView2"
        android:layout_toEndOf="@+id/image_set_about"/>

    <ScrollView
        android:id="@+id/scrollSetting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@+id/imageView12"
        android:layout_alignTop="@+id/imageView2">
    </ScrollView>
</RelativeLayout>
